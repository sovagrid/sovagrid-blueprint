[Unit]
Description=Check a locally approved SovaGrid update candidate

[Timer]
OnBootSec=10min
OnUnitInactiveSec=15min
RandomizedDelaySec=1min
AccuracySec=1min
Unit=sovagrid-auto-update.service

[Install]
WantedBy=timers.target
