[Unit]
Description=Check the opt-in signed SovaGrid release feed

[Timer]
OnBootSec=20min
OnUnitInactiveSec=1h
RandomizedDelaySec=5min
AccuracySec=1min
Unit=sovagrid-release-feed.service

[Install]
WantedBy=timers.target
