[Unit]
Description=Apply one locally approved SovaGrid source bundle when idle
ConditionPathExists=/etc/sovagrid/auto-update.json
After=docker.service network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /opt/sovagrid-src/sovagrid-blueprint/deploy/auto_update.py run
UMask=0077
TimeoutStartSec=0
Nice=10
IOSchedulingClass=idle
