[Unit]
Description=Apply one approved SovaGrid Hub-only update when idle
ConditionPathExists=/etc/sovagrid-hub/hub-only-auto-update.json
After=docker.service network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /opt/sovagrid-src/sovagrid-blueprint/deploy/hub_only_auto_update.py run
UMask=0077
TimeoutStartSec=0
Nice=10
IOSchedulingClass=idle
