[Unit]
Description=SovaGrid restricted Hub backup controller
Requires=sovagrid-hub-backup-control.socket
After=sovagrid-hub-backup-control.socket

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/sovagrid-src/sovagrid-hub
ExecStart=/usr/bin/python3 -B -E -S -m sovagrid_hub.backup_broker
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_SETUID CAP_SETGID CAP_SYS_CHROOT CAP_NET_BIND_SERVICE
AmbientCapabilities=
# Offline restore must atomically exchange the hub directory with a staging
# directory in /var/lib/sovagrid; writable child paths alone cannot rename
# entries in their read-only parent under ProtectSystem=strict.
ReadWritePaths=/var/lib/sovagrid /opt/sovagrid-candidates /var/lib/sovagrid-host-backup-operations /etc/sovagrid
# Docker Compose validates and recreates the Web container inside this unit.
# On hosts with many CPU cores its Go runtime needs more than 32 threads.
TasksMax=128
MemoryMax=512M
KillMode=control-group
