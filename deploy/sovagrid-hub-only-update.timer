[Unit]
Description=Check a locally approved SovaGrid Hub-only update candidate

[Timer]
OnActiveSec=10min
OnUnitInactiveSec=15min
RandomizedDelaySec=1min
AccuracySec=1min
Unit=sovagrid-hub-only-update.service

[Install]
WantedBy=timers.target
