[Unit]
Description=Apply one reviewed SovaGrid external Agent update %i
After=local-fs.target network-online.target
Wants=network-online.target
OnFailure=sovagrid-external-agent-recovery.service
ConditionPathIsDirectory=/var/lib/sovagrid/external-agent-operations

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -B -I /opt/sovagrid-src/sovagrid-blueprint/deploy/external_agent_operation.py apply %i
TimeoutStartSec=960
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
# The reviewed updater takes an O_RDWR lock and stages a private projection in
# /opt/sovagrid-candidates. Keep that root-only directory writable here.
ReadOnlyPaths=/opt/sovagrid-src
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_SETUID CAP_SETGID CAP_SYS_CHROOT CAP_NET_BIND_SERVICE
AmbientCapabilities=
ReadWritePaths=/etc/systemd/system
TasksMax=128
MemoryMax=512M
KillMode=control-group
