[Unit]
Description=SovaGrid Hub backup metadata and snapshot socket

[Socket]
ListenStream=/run/sovagrid-hub-backup/control.sock
SocketUser=root
SocketGroup=sovagrid-hub
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=true
Service=sovagrid-hub-backup-control.service

[Install]
WantedBy=sockets.target
