[Unit]
Description=Stage one cryptographically signed SovaGrid server release
ConditionPathExists=/etc/sovagrid/release-feed.json
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /opt/sovagrid-src/sovagrid-blueprint/deploy/release_feed.py poll
UMask=0077
TimeoutStartSec=5min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
