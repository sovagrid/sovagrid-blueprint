{
  "format": 1,
  "hub_runtime": {
    "python_minimum": "3.10",
    "required_python_modules": [
      "sqlite3",
      "ssl",
      "fcntl",
      "pwd"
    ],
    "required_crypto": [
      "hashlib.scrypt"
    ],
    "filesystem_capabilities": [
      "posix-ownership-and-modes",
      "O_NOFOLLOW",
      "dir_fd-operations"
    ],
    "network": [
      "ipv4-tcp"
    ]
  },
  "managed_host": {
    "kernel": "linux",
    "python_executable": "/usr/bin/python3",
    "python_minimum": "3.10",
    "systemd_minimum": "247",
    "systemd_states": [
      "running",
      "degraded"
    ],
    "identity": "posix-root-uid-and-gid-0",
    "nologin": "/usr/sbin/nologin",
    "procfs": [
      "/proc/stat",
      "/proc/meminfo",
      "/proc/net/dev",
      "/proc/self/fd"
    ],
    "command_semantics": [
      "gnu-coreutils",
      "util-linux",
      "iproute2"
    ],
    "automatic_package_adapters": [
      "apt"
    ],
    "container_engine": "docker",
    "compose_minimum_major": 2,
    "bash_minimum_major": 4,
    "journal": "systemd-journal-runtime",
    "docker_executable": "/usr/bin/docker",
    "docker_endpoint": "unix:///var/run/docker.sock"
  },
  "portable_restore": {
    "contract": "full/v2",
    "platform_pairs": [
      "ubuntu:22.04",
      "ubuntu:24.04",
      "ubuntu:26.04"
    ]
  }
}
